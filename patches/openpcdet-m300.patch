diff --git a/pcdet/datasets/custom/torch_eval_overlap.py b/pcdet/datasets/custom/torch_eval_overlap.py
new file mode 100644
index 0000000..97553df
--- /dev/null
+++ b/pcdet/datasets/custom/torch_eval_overlap.py
@@ -0,0 +1,33 @@
+"""Opt-in KITTI evaluation overlap using the installed OpenPCDet CUDA op."""
+import numpy as np
+import torch
+from ...ops.iou3d_nms import iou3d_nms_cuda
+
+
+def rotate_overlap(boxes, query_boxes, criterion=-1, device_id=0):
+    # KITTI evaluator only requests IoU (-1) or intersection area (2).
+    if criterion not in (-1, 2):
+        raise ValueError('Only IoU and intersection area are supported')
+    if len(boxes) == 0 or len(query_boxes) == 0:
+        return np.zeros((len(boxes), len(query_boxes)), dtype=np.float32)
+    device = torch.device('cuda', device_id)
+
+    def convert(values):
+        out = np.zeros((len(values), 7), dtype=np.float32)
+        out[:, :2] = values[:, :2]
+        out[:, 3:5] = values[:, 2:4]
+        out[:, 5] = 1
+        # Numba/KITTI BEV angles are clockwise; CUDA op expects counterclockwise.
+        out[:, 6] = -values[:, 4]
+        return torch.as_tensor(out, device=device).contiguous()
+
+    with torch.cuda.device(device):
+        a, b = convert(boxes), convert(query_boxes)
+        overlap = torch.zeros((len(a), len(b)), device=device, dtype=torch.float32)
+        iou3d_nms_cuda.boxes_overlap_bev_gpu(a, b, overlap)
+        area_a = (a[:, 3] * a[:, 4])[:, None]
+        area_b = (b[:, 3] * b[:, 4])[None, :]
+        overlap = torch.minimum(overlap.clamp_min(0), torch.minimum(area_a, area_b))
+        if criterion == -1:
+            overlap = overlap / (area_a + area_b - overlap).clamp_min(1e-8)
+        return overlap.cpu().numpy()

