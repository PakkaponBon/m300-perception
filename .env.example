# Copy to .env, replace paths, then: set -a; source .env; set +a
# Neither launcher auto-loads this file.
PERCEPTION_OPENPCDET_ROOT=/absolute/path/to/OpenPCDet
PERCEPTION_PYTHON=/absolute/path/to/openpcdet_env/bin/python
PERCEPTION_CHECKPOINT=/absolute/path/to/trusted/checkpoint_epoch_200.pth
PERCEPTION_INPUT_TOPIC=/pointcloud
PERCEPTION_FRAME_ID=m300_lidar
PERCEPTION_INTENSITY_FIELD=intensity
PERCEPTION_DECAY_TIME_SEC=0.3
PERCEPTION_SCORE_THRESHOLD=0.3
# Optional model YAML; default is the original M300 PointPillars preset.
# PERCEPTION_MODEL_CONFIG=/absolute/path/to/compatible_model.yaml
# Generic launcher: optional external driver's already-built workspace.
# PERCEPTION_WS_SETUP=/absolute/path/to/workspace/install/setup.bash

# Compatibility aliases for start_m300_detection.sh:
M300_OPENPCDET_ROOT="$PERCEPTION_OPENPCDET_ROOT"
M300_PYTHON="$PERCEPTION_PYTHON"
M300_CHECKPOINT="$PERCEPTION_CHECKPOINT"
# M300_WS_SETUP=/absolute/path/to/m300_workspace/install/setup.bash
