# Example only: edit paths for YOUR machine.
# Shell launchers use exported variables; they do not auto-load this file.
# Run: set -a; source .env; set +a
M300_OPENPCDET_ROOT=/absolute/path/to/OpenPCDet
M300_PYTHON=/absolute/path/to/openpcdet_env/bin/python
M300_CHECKPOINT=/absolute/path/to/trusted/checkpoint_epoch_200.pth
